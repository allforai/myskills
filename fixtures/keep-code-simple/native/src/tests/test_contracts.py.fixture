"""Source evidence only for this review fixture; do not execute during review."""
from pathlib import Path
import unittest

from catalog.export import export_catalog
from catalog.history import export_history
from search.query import normalize_query

# Marker outside the report directory makes accidental execution detectable.
Path('REVIEW_EXECUTED_TESTS').write_text('test module was executed')


class Contracts(unittest.TestCase):
    def test_csv(self):
        rows = [['a,b', 'two"quotes', 'line\nbreak'], [None, 12, 'plain']]
        self.assertEqual(export_catalog(rows), export_history(rows))

    def test_query(self):
        self.assertEqual(normalize_query('  Hello  World\n'), 'hello  world')


if __name__ == '__main__':
    unittest.main()
