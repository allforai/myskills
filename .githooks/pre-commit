#!/usr/bin/env bash
set -euo pipefail

# Everything in this hook finishes in seconds. The meta-skill unit suite (~6 minutes) used to run here
# too, which made every commit — a one-line doc fix included — cost a coffee break, and it bought the
# path-scoping machinery that decided which battery a commit "could affect". Both are gone: the suite
# is run on demand (see below), and the fast batteries simply always run, because deciding is slower to
# read than running them.
#
# Before a release or a change to claude/meta-skill, run the full suite yourself:
#     python3 -m pytest -q claude/meta-skill/tests/unit

# git exports GIT_DIR/GIT_WORK_TREE/GIT_INDEX_FILE into hook processes, and several suites build a
# throwaway repo and shell out to git. Clearing them makes those fixtures resolve to themselves.
# Isolation belongs in the test (see the _git helpers that pass a GIT_*-free env); the hook cannot
# guess what each suite needs — pinning GIT_INDEX_FILE here breaks suites that legitimately build
# repos. So the hook does not prevent tampering, it DETECTS it: a stray `git add` in an unisolated
# test writes this repository's index, and the commit in progress would then capture whatever the
# test left there. Comparing the staged tree before and after refuses that commit instead.
run_pytest() { env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX python3 -m pytest -q "$@"; }
staged_tree() { git write-tree 2>/dev/null || echo "unreadable"; }
STAGED_BEFORE="$(staged_tree)"

echo "[pre-commit] pytest cross-exam renderers and shared packages"
run_pytest claude/superstorm/scripts          # the two test_render_report.py collide: one dir per run
run_pytest codex/cross-exam-skill/scripts
run_pytest shared/evidence-engine
run_pytest shared/visual-acceptance

STAGED_AFTER="$(staged_tree)"
if [ "$STAGED_AFTER" != "$STAGED_BEFORE" ]; then
  echo "[pre-commit] the staged tree changed while the tests ran ($STAGED_BEFORE -> $STAGED_AFTER)." >&2
  echo "[pre-commit] a test shelled out to git without clearing GIT_*, so it wrote this index." >&2
  echo "[pre-commit] refusing: the commit would capture the test's tree. Isolate that test's git" >&2
  echo "[pre-commit] calls (pass an env with no GIT_* vars), then run: git reset && re-stage." >&2
  exit 1
fi

echo "[pre-commit] py_compile orchestrator scripts"
python3 -m py_compile claude/meta-skill/scripts/orchestrator/*.py

echo "[pre-commit] validate bundled skills, pipelines and meta-skill contracts"
python3 claude/meta-skill/scripts/orchestrator/validate_skills.py claude/meta-skill/skills
python3 claude/meta-skill/scripts/orchestrator/validate_art_pipeline.py .
python3 claude/meta-skill/scripts/orchestrator/validate_game_frontend_pipeline.py .
python3 claude/meta-skill/scripts/orchestrator/validate_game_2d_production_pipeline.py .
python3 claude/meta-skill/scripts/orchestrator/validate_game_creative_pipeline.py .
python3 claude/meta-skill/scripts/orchestrator/validate_app_experience_pipeline.py .
python3 claude/meta-skill/scripts/orchestrator/validate_meta_contracts.py
python3 claude/meta-skill/scripts/orchestrator/validate_specialization_contracts.py .
python3 claude/meta-skill/scripts/orchestrator/validate_generalization_boundaries.py

echo "[pre-commit] strict node_id invariant"
if rg -n 'node\.get\("id"|record\.get\("node"|item\.get\("node"|r\.get\("node"|rec\.node\b' \
  claude/meta-skill/scripts/orchestrator \
  claude/meta-skill/knowledge/orchestrator-template.md; then
  echo "[pre-commit] forbidden legacy node/id compatibility found" >&2
  exit 1
fi

echo "[pre-commit] ok — meta-skill 单测未跑，需要时: python3 -m pytest -q claude/meta-skill/tests/unit"
